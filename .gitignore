node_modules
dist/
.sonata/
.superpowers/

# Generated per-user by `sonata init` (contains absolute paths)
.mcp.json
sonata.toml

# Everything under .claude/ is per-machine, not source: agents and skills that
# `sonata init`/`sonata sync` generate from this machine's sonata.toml, and the
# routing state `sonata route` writes into settings. Ignored wholesale so a new
# file Claude Code or sonata starts writing there does not silently become a
# candidate for commit.
.claude/

# Isolated worktrees for subagent-driven plan execution (git-ignored scratch).
.worktrees/

# Impeccable's session scratch: the decision-page payloads/answers and the
# detector's cache are per-run, not source. The surface briefs under
# .impeccable/surfaces/ ARE source — they carry each surface's direction
# contract, which later sessions reload — so they are force-added below.
.impeccable/questions/
.impeccable/hook.cache.json
